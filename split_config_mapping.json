{
  "strategy_definitions": {
    "Strategy 1": {
      "code": "PP1",
      "name": "Fixed Mahalanobis Stratification",
      "description": "Computes Mahalanobis distance of specimen centroids to a static class centroid and assigns tail-end outliers to test/val splits to enforce difficulty."
    },
    "Strategy 2": {
      "code": "PP2",
      "name": "Iterative Mahalanobis Allocation",
      "description": "Iteratively re-estimates the class covariance matrix and centroid after assigning each specimen, preventing outlier masking in skewed distributions."
    },
    "Strategy 3": {
      "code": "PP4",
      "name": "Hierarchical Agglomerative Partitioning",
      "description": "Applies Ward's linkage clustering on specimen centroids and allocates intact sub-trees to splits based on an elbow criterion on WCSS."
    },
    "Strategy 4": {
      "code": "PP5",
      "name": "Cosine Feature Graph Partitioning",
      "description": "Constructs a k-nearest neighbor cosine similarity graph across specimen centroids and finds min-cut graph partitions to minimize inter-split similarity."
    },
    "Strategy 5": {
      "code": "PP7",
      "name": "Adversarial Density Validation",
      "description": "Trains a domain classifier to distinguish candidate splits and selects partitions where adversarial AUC is nearest 0.5 (maximum distributional overlap)."
    },
    "Strategy 6": {
      "code": "PP8",
      "name": "Stratified Group Allocation",
      "description": "Extends GroupKFold to optimize multi-objective group-disjointness while minimizing per-species sample size imbalance."
    },
    "Strategy 7": {
      "code": "PP9",
      "name": "Agglomerative Stratified Banding",
      "description": "Combines feature-space clustering with geometric distance-band stratification (Near, Mid, Far) to ensure uniform representation across splits."
    }
  },
